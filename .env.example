# Nothing is asked for on deploy.
#
# Set by the Blueprint: RSSBRIDGE_authentication_token (generated),
# RSSBRIDGE_system_timezone.
#
# Any config.ini.php setting can be set as RSSBRIDGE_<section>_<key>, for example:
# RSSBRIDGE_system_enabled_bridges=Youtube,Reddit,Twitch   # comma-separated; default is all
# RSSBRIDGE_cache_type=file
# RSSBRIDGE_GithubIssueBridge_token=                        # API token for that bridge
# Full list: https://github.com/rss-bridge/rss-bridge/blob/master/config.default.ini.php
